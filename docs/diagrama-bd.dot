digraph banco_simulador {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad=0.4, nodesep=0.8, ranksep=1.4,
         label="Banco Simulador - Diagrama de la base de datos (MySQL)\n ", labelloc=t, fontsize=20];
  node  [shape=plain, fontname="Helvetica", fontsize=12];
  edge  [fontname="Helvetica", fontsize=11, color="#495057", arrowhead=crowodot, arrowtail=teetee, dir=both];

  usuarios [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0d6efd">
      <TR><TD BGCOLOR="#0d6efd" COLSPAN="3"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INT AUTO_INCREMENT</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">documento</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nombres</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">apellidos</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR(255) bcrypt</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">rol</TD><TD ALIGN="LEFT">ENUM(ADMIN, CLIENTE)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">ENUM(ACTIVO, INACTIVO, BLOQUEADO)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  cuentas [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#198754">
      <TR><TD BGCOLOR="#198754" COLSPAN="3"><FONT COLOR="white"><B>cuentas</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INT AUTO_INCREMENT</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">numero_cuenta</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT" PORT="usuario">usuario_id</TD><TD ALIGN="LEFT">INT → usuarios.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">ENUM(AHORROS, CORRIENTE)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">saldo</TD><TD ALIGN="LEFT">DECIMAL(15,2) CHECK &gt;= 0</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">pin_hash</TD><TD ALIGN="LEFT">VARCHAR(255) bcrypt</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">intentos_pin</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">ENUM(ACTIVO, INACTIVO, BLOQUEADO)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  transferencias [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#fd7e14">
      <TR><TD BGCOLOR="#fd7e14" COLSPAN="3"><FONT COLOR="white"><B>transferencias</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INT AUTO_INCREMENT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT" PORT="origen">cuenta_origen_id</TD><TD ALIGN="LEFT">INT → cuentas.id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT" PORT="destino">cuenta_destino_id</TD><TD ALIGN="LEFT">INT → cuentas.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">monto</TD><TD ALIGN="LEFT">DECIMAL(15,2) CHECK &gt; 0</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">CHECK origen &lt;&gt; destino</FONT></TD></TR>
    </TABLE>>];

  movimientos [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6f42c1">
      <TR><TD BGCOLOR="#6f42c1" COLSPAN="3"><FONT COLOR="white"><B>movimientos</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INT AUTO_INCREMENT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT" PORT="cuenta">cuenta_id</TD><TD ALIGN="LEFT">INT → cuentas.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">ENUM(CONSIGNACION, RETIRO_CAJERO,<BR ALIGN="LEFT"/>TRANSFERENCIA_ENVIADA, TRANSFERENCIA_RECIBIDA)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">DECIMAL(15,2) (+ entra / - sale)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">saldo_resultante</TD><TD ALIGN="LEFT">DECIMAL(15,2)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT" PORT="transf">transferencia_id</TD><TD ALIGN="LEFT">INT NULL → transferencias.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  usuarios:id -> cuentas:usuario       [label=" 1 usuario\n tiene N cuentas ", arrowhead=crowodot, arrowtail=teetee];
  cuentas:id  -> transferencias:origen [label=" envía ", arrowhead=crowodot, arrowtail=teetee];
  cuentas:id  -> transferencias:destino[label=" recibe ", arrowhead=crowodot, arrowtail=teetee, style=dashed];
  cuentas:id  -> movimientos:cuenta    [label=" 1 cuenta\n tiene N movimientos ", arrowhead=crowodot, arrowtail=teetee];
  transferencias:id -> movimientos:transf [label=" genera 2 movimientos ", arrowhead=crowodot, arrowtail=teetee, style=dashed];
}
